APP_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://ekb:ekb@localhost:5432/ekb
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
QDRANT_URL=http://localhost:6333
OPENSEARCH_URL=http://localhost:9200
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=ekb
KEYCLOAK_AUDIENCE=ekb-backend
EMBEDDING_BASE_URL=http://localhost:9100/v1
EMBEDDING_MODEL=mock-embedding
EMBEDDING_DIM=1024
RERANK_BASE_URL=http://localhost:9100/v1
RERANK_MODEL=mock-reranker
CHAT_BASE_URL=http://localhost:9100/v1
CHAT_MODEL=mock-chat
LLM_API_KEY=EMPTY
# openai = OpenAI-compatible endpoints above; mock = in-process fake models
LLM_PROVIDER=openai
INDEX_ALIAS=kb_chunks

# MES MySQL connector (S1.2) — password only via env, never in StructuredSource.meta
# MES_MYSQL_PASSWORD=

# PII / ClamAV — default off. Production guidance: docs/ops/pii-clamav.md
# VIRUS_SCAN_BACKEND=none
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# PII_MASK_ON_INGEST=false
# PII_MASK_ON_OUTPUT=false
# PII_TYPES=["phone","id_card","bank_card"]
