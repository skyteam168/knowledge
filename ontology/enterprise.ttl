@prefix : <https://flyknit.local/ontology/enterprise#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Flyknit Enterprise Knowledge Ontology (TBox only)
# Runtime ABox lives in PostgreSQL; this file is the contract.
# Enum values in backend StrEnum must stay aligned (see catalog.py).
# versionInfo 1.1.0 — O1.1 ISA-95 / FMEA industrial object classes
#################################################################

: a owl:Ontology ;
    rdfs:label "Flyknit Enterprise Knowledge Ontology"@en ;
    rdfs:label "飞织企业知识本体"@zh ;
    rdfs:comment "企业知识库概念层 TBox：术语类型、KO 类型、关系、结构化镜像与工业对象（ISA-95/FMEA）。运行时实例存 PostgreSQL，不提供 SPARQL。"@zh ;
    owl:versionInfo "1.1.0" .

#################################################################
# Top-level classes
#################################################################

:TerminologyEntity a owl:Class ;
    rdfs:label "Terminology entity"@en ;
    rdfs:label "术语实体"@zh ;
    rdfs:comment "组织内规范术语，对应 terminology_entities。"@zh .

:KnowledgeObject a owl:Class ;
    rdfs:label "Knowledge object"@en ;
    rdfs:label "知识条目"@zh ;
    rdfs:comment "人工治理的知识条目 KO，对应 knowledge_objects。"@zh .

:StructuredObject a owl:Class ;
    rdfs:label "Structured mirror object"@en ;
    rdfs:label "结构化镜像对象"@zh ;
    rdfs:comment "ERP/MES 等本地镜像行，经 structured_entity_links 挂接术语或 KO。"@zh .

:StructuredDomain a owl:Class ;
    rdfs:label "Structured domain"@en ;
    rdfs:label "结构化业务域"@zh ;
    rdfs:comment "对应 structured_domains。"@zh .

:IndustrialObject a owl:Class ;
    rdfs:subClassOf :StructuredObject ;
    rdfs:label "Industrial object"@en ;
    rdfs:label "工业对象"@zh ;
    rdfs:comment "ISA-95 资产层级与 FMEA/工艺对象的公共父类；ABox 仍在 PostgreSQL。"@zh .

#################################################################
# TerminologyEntityType → subclasses
#################################################################

:Device a owl:Class ;
    rdfs:subClassOf :TerminologyEntity ;
    rdfs:label "Device"@en ;
    rdfs:label "设备"@zh ;
    rdfs:comment "enum TerminologyEntityType.device / KoType.device / StructuredObjectType.device"@en .

:Process a owl:Class ;
    rdfs:subClassOf :TerminologyEntity ;
    rdfs:label "Process"@en ;
    rdfs:label "工艺/流程"@zh ;
    rdfs:comment "enum TerminologyEntityType.process / KoType.process"@en .

:Defect a owl:Class ;
    rdfs:subClassOf :TerminologyEntity ;
    rdfs:label "Defect"@en ;
    rdfs:label "缺陷"@zh ;
    rdfs:comment "enum TerminologyEntityType.defect / KoType.defect"@en .

:Policy a owl:Class ;
    rdfs:subClassOf :TerminologyEntity ;
    rdfs:label "Policy"@en ;
    rdfs:label "制度/政策"@zh ;
    rdfs:comment "enum TerminologyEntityType.policy / KoType.policy"@en .

:ItTerm a owl:Class ;
    rdfs:subClassOf :TerminologyEntity ;
    rdfs:label "IT term"@en ;
    rdfs:label "IT 术语"@zh ;
    rdfs:comment "enum TerminologyEntityType.it_term / KoType.it_term"@en .

:Other a owl:Class ;
    rdfs:subClassOf :TerminologyEntity ;
    rdfs:label "Other"@en ;
    rdfs:label "其他"@zh ;
    rdfs:comment "enum TerminologyEntityType.other"@en .

:Component a owl:Class ;
    rdfs:subClassOf :TerminologyEntity ;
    rdfs:label "Component"@en ;
    rdfs:label "部件"@zh ;
    rdfs:comment "enum TerminologyEntityType.component / KoType.component / StructuredObjectType.component"@en .

:FailureMode a owl:Class ;
    rdfs:subClassOf :TerminologyEntity ;
    rdfs:label "Failure mode"@en ;
    rdfs:label "故障模式"@zh ;
    rdfs:comment "enum TerminologyEntityType.failure_mode / KoType.failure_mode / StructuredObjectType.failure_mode"@en .

#################################################################
# KoType content shapes (presentation) — also under KnowledgeObject
#################################################################

:Faq a owl:Class ;
    rdfs:subClassOf :KnowledgeObject ;
    rdfs:label "FAQ"@en ;
    rdfs:comment "enum KoType.faq"@en .

:Qa a owl:Class ;
    rdfs:subClassOf :KnowledgeObject ;
    rdfs:label "Q&A"@en ;
    rdfs:comment "enum KoType.qa"@en .

:Card a owl:Class ;
    rdfs:subClassOf :KnowledgeObject ;
    rdfs:label "Card"@en ;
    rdfs:comment "enum KoType.card"@en .

:PolicySummary a owl:Class ;
    rdfs:subClassOf :KnowledgeObject ;
    rdfs:label "Policy summary"@en ;
    rdfs:label "制度摘要"@zh ;
    rdfs:comment "enum KoType.policy_summary"@en .

# Business KO kinds reuse the same local names as terminology subclasses
# but are also KnowledgeObject (multiple inheritance for contract clarity).
:Device rdfs:subClassOf :KnowledgeObject .
:Process rdfs:subClassOf :KnowledgeObject .
:Defect rdfs:subClassOf :KnowledgeObject .
:Policy rdfs:subClassOf :KnowledgeObject .
:ItTerm rdfs:subClassOf :KnowledgeObject .
:Component rdfs:subClassOf :KnowledgeObject .
:FailureMode rdfs:subClassOf :KnowledgeObject .

#################################################################
# Structured domain kinds
#################################################################

:EquipmentDomain a owl:Class ;
    rdfs:subClassOf :StructuredDomain ;
    rdfs:label "Equipment domain"@en ;
    rdfs:label "设备域"@zh ;
    rdfs:comment "enum StructuredDomainKind.equipment → OWL EquipmentDomain（避免与 ISA-95 Equipment 冲突）"@zh .

:GenericDomain a owl:Class ;
    rdfs:subClassOf :StructuredDomain ;
    rdfs:label "Generic domain"@en ;
    rdfs:label "通用业务域"@zh ;
    rdfs:comment "enum StructuredDomainKind.generic"@en .

#################################################################
# StructuredObjectType — legacy equip_* + ISA-95 / FMEA
#################################################################

:WorkOrder a owl:Class ;
    rdfs:subClassOf :StructuredObject ;
    rdfs:label "Work order"@en ;
    rdfs:label "工单"@zh ;
    rdfs:comment "enum StructuredObjectType.work_order"@en .

:SparePart a owl:Class ;
    rdfs:subClassOf :StructuredObject ;
    rdfs:label "Spare part"@en ;
    rdfs:label "备件"@zh ;
    rdfs:comment "enum StructuredObjectType.spare_part"@en .

# Leaf device row (equip_devices) is also an industrial object.
:Device rdfs:subClassOf :StructuredObject , :IndustrialObject .

:Site a owl:Class ;
    rdfs:subClassOf :IndustrialObject ;
    rdfs:label "Site"@en ;
    rdfs:label "工厂/厂区"@zh ;
    rdfs:comment "enum StructuredObjectType.site；ISA-95 Site"@zh .

:Area a owl:Class ;
    rdfs:subClassOf :IndustrialObject ;
    rdfs:label "Area"@en ;
    rdfs:label "车间/区域"@zh ;
    rdfs:comment "enum StructuredObjectType.area；ISA-95 Area"@zh .

:Line a owl:Class ;
    rdfs:subClassOf :IndustrialObject ;
    rdfs:label "Line"@en ;
    rdfs:label "产线"@zh ;
    rdfs:comment "enum StructuredObjectType.line；ISA-95 Production Line / Work Center"@zh .

:Equipment a owl:Class ;
    rdfs:subClassOf :IndustrialObject ;
    rdfs:label "Equipment"@en ;
    rdfs:label "设备（层级）"@zh ;
    rdfs:comment "enum StructuredObjectType.equipment；ISA-95 Equipment（与 equip_devices 的 Device 并存）"@zh .

:Component rdfs:subClassOf :IndustrialObject .

:Material a owl:Class ;
    rdfs:subClassOf :IndustrialObject ;
    rdfs:label "Material"@en ;
    rdfs:label "物料"@zh ;
    rdfs:comment "enum StructuredObjectType.material"@en .

:Operation a owl:Class ;
    rdfs:subClassOf :IndustrialObject ;
    rdfs:label "Operation"@en ;
    rdfs:label "工序"@zh ;
    rdfs:comment "enum StructuredObjectType.operation"@en .

:ProcessParameter a owl:Class ;
    rdfs:subClassOf :IndustrialObject ;
    rdfs:label "Process parameter"@en ;
    rdfs:label "工艺参数"@zh ;
    rdfs:comment "enum StructuredObjectType.process_parameter"@en .

:FailureMode rdfs:subClassOf :IndustrialObject .

:Event a owl:Class ;
    rdfs:subClassOf :IndustrialObject ;
    rdfs:label "Event"@en ;
    rdfs:label "事件/报警"@zh ;
    rdfs:comment "enum StructuredObjectType.event"@en .

#################################################################
# KoRelationType → object properties
#################################################################

:relatedTo a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "related to"@en ;
    rdfs:label "相关"@zh ;
    rdfs:domain :KnowledgeObject ;
    rdfs:range :KnowledgeObject ;
    rdfs:comment "enum KoRelationType.related_to"@en .

:partOf a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "part of"@en ;
    rdfs:label "组成/从属"@zh ;
    rdfs:domain :KnowledgeObject ;
    rdfs:range :KnowledgeObject ;
    rdfs:comment "enum KoRelationType.part_of"@en .

:dependsOn a owl:ObjectProperty ;
    rdfs:label "depends on"@en ;
    rdfs:label "依赖"@zh ;
    rdfs:domain :KnowledgeObject ;
    rdfs:range :KnowledgeObject ;
    rdfs:comment "enum KoRelationType.depends_on"@en .

:causes a owl:ObjectProperty ;
    rdfs:label "causes"@en ;
    rdfs:label "导致"@zh ;
    rdfs:domain :KnowledgeObject ;
    rdfs:range :KnowledgeObject ;
    rdfs:comment "enum KoRelationType.causes；建议 defect → device|process（软约束）"@zh .

:mitigates a owl:ObjectProperty ;
    rdfs:label "mitigates"@en ;
    rdfs:label "缓解/处置"@zh ;
    rdfs:domain :KnowledgeObject ;
    rdfs:range :KnowledgeObject ;
    rdfs:comment "enum KoRelationType.mitigates；建议 policy|faq|qa → defect（软约束）"@zh .

:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to"@en ;
    rdfs:label "适用于"@zh ;
    rdfs:domain :KnowledgeObject ;
    rdfs:range :KnowledgeObject ;
    rdfs:comment "enum KoRelationType.applies_to；建议 policy → device|process|it_term（软约束）"@zh .

#################################################################
# ObjectRelationType → industrial directed relations (O2.1)
#################################################################

:hasPart a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "has part"@en ;
    rdfs:label "包含部件"@zh ;
    rdfs:domain :StructuredObject ;
    rdfs:range :StructuredObject ;
    rdfs:comment "enum ObjectRelationType.has_part"@en .

:locatedIn a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "located in"@en ;
    rdfs:label "位于"@zh ;
    rdfs:domain :StructuredObject ;
    rdfs:range :StructuredObject ;
    rdfs:comment "enum ObjectRelationType.located_in"@en .

:hasFailureMode a owl:ObjectProperty ;
    rdfs:label "has failure mode"@en ;
    rdfs:label "具有故障模式"@zh ;
    rdfs:domain :StructuredObject ;
    rdfs:range :StructuredObject ;
    rdfs:comment "enum ObjectRelationType.has_failure_mode"@en .

:causedBy a owl:ObjectProperty ;
    rdfs:label "caused by"@en ;
    rdfs:label "由…导致"@zh ;
    rdfs:domain :StructuredObject ;
    rdfs:range :StructuredObject ;
    rdfs:comment "enum ObjectRelationType.caused_by"@en .

:consumes a owl:ObjectProperty ;
    rdfs:label "consumes"@en ;
    rdfs:label "消耗"@zh ;
    rdfs:domain :StructuredObject ;
    rdfs:range :StructuredObject ;
    rdfs:comment "enum ObjectRelationType.consumes"@en .

:workOrderFor a owl:ObjectProperty ;
    rdfs:label "work order for"@en ;
    rdfs:label "工单针对"@zh ;
    rdfs:domain :StructuredObject ;
    rdfs:range :StructuredObject ;
    rdfs:comment "enum ObjectRelationType.work_order_for；亦覆盖 equip work_order→device"@zh .

:spareFor a owl:ObjectProperty ;
    rdfs:label "spare for"@en ;
    rdfs:label "备件适用于"@zh ;
    rdfs:domain :StructuredObject ;
    rdfs:range :StructuredObject ;
    rdfs:comment "enum ObjectRelationType.spare_for"@en .

#################################################################
# Structured link properties (structured_entity_links semantics)
#################################################################

:linkedToTerminology a owl:ObjectProperty ;
    rdfs:label "linked to terminology"@en ;
    rdfs:label "挂接术语"@zh ;
    rdfs:domain :StructuredObject ;
    rdfs:range :TerminologyEntity ;
    rdfs:comment "structured_entity_links.terminology_entity_id"@en .

:linkedToKnowledgeObject a owl:ObjectProperty ;
    rdfs:label "linked to knowledge object"@en ;
    rdfs:label "挂接知识条目"@zh ;
    rdfs:domain :StructuredObject ;
    rdfs:range :KnowledgeObject ;
    rdfs:comment "structured_entity_links.ko_id"@en .

:hasAlias a owl:DatatypeProperty ;
    rdfs:label "has alias"@en ;
    rdfs:label "别名"@zh ;
    rdfs:domain :TerminologyEntity ;
    rdfs:range xsd:string ;
    rdfs:comment "terminology_aliases.alias"@en .

:externalId a owl:DatatypeProperty ;
    rdfs:label "external id"@en ;
    rdfs:label "外部编号"@zh ;
    rdfs:domain :StructuredObject ;
    rdfs:range xsd:string ;
    rdfs:comment "equip_* / structured_records.external_id"@en .
