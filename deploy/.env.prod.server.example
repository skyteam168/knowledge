# Copy on the server (NEVER commit the filled file):
#   cp .env.prod.server.example .env.prod.server
#   # fill secrets, then:
#   docker compose -f docker-compose.prod.server.yml --env-file .env.prod.server up -d --build --wait
#
# Before first start, on host PostgreSQL create:
#   CREATE DATABASE ekb OWNER postgres;
#   CREATE DATABASE keycloak OWNER postgres;
#
# Stack: host PG + Redis; Docker for MinIO / Qdrant / OpenSearch / Keycloak / app.
# Host ports used: frontend 8088, Keycloak 8082 (8080/8081 already occupied), MinIO 9000.

REGISTRY=ekb
TAG=latest

# ---- public URLs (LAN; add HTTPS reverse proxy later) ----
PUBLIC_URL=http://10.10.130.170:8088
KEYCLOAK_PUBLIC_URL=http://10.10.130.170:8082
MINIO_PUBLIC_ENDPOINT=http://10.10.130.170:9000
HTTP_BIND=0.0.0.0
HTTP_PORT=8088
KEYCLOAK_BIND=0.0.0.0
KEYCLOAK_HOST_PORT=8082
MINIO_BIND=0.0.0.0
MINIO_HOST_PORT=9000

# ---- existing PostgreSQL on the host ----
POSTGRES_HOST=10.10.130.170
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# App DB (do NOT use the shared "postgres" maintenance DB)
POSTGRES_DB=ekb

# ---- existing Redis on the host ----
REDIS_HOST=10.10.130.170
REDIS_PORT=6379
# If password contains @ : / # etc, URL-encode for REDIS_URL (e.g. redis@2026 -> redis%402026)
REDIS_PASSWORD=
REDIS_DB=1

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

MINIO_ROOT_USER=ekb
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=ekb-documents
QDRANT_API_KEY=
OPENSEARCH_VERSION=2.19.2
OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=ekb
KEYCLOAK_REALM_FILE=./keycloak/realm-ekb.prod.json

WEB_CONCURRENCY=4
WORKER_PROCESSES=2
WORKER_THREADS=4

# Models (OpenAI-compatible)
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_SEND_DIMENSIONS=true
EMBEDDING_BATCH_SIZE=10
RERANK_BASE_URL=
RERANK_MODEL=qwen3-rerank
RERANK_PATH=/reranks
RERANK_INSTRUCT=
CHAT_BASE_URL=
CHAT_MODEL=deepseek-v4.1-flash
CHAT_FALLBACK_BASE_URL=
CHAT_FALLBACK_MODEL=
CHAT_EXTRA_BODY={"enable_thinking": false}
CHAT_EVIDENCE_MIN_SCORE=0.45
CHAT_EVIDENCE_CONFIDENT_SCORE=0.7
CHAT_ANSWER_IMAGES_ENABLED=true
CHAT_ANSWER_IMAGES_PER_MATERIAL=2
CHAT_ANSWER_IMAGES_TOTAL=6

OPEN_API_ENABLED=true
OPEN_API_KEY_PEPPER=
OPEN_API_TRUSTED_PROXIES=[]
LLM_API_KEY=
PDF_PARSER=auto
INSTALL_DOCLING=false

DIRECTORY_SECRET_KEY=
OIDC_BRIDGE_ENABLED=true
OIDC_BRIDGE_SIGNING_KEY=
OIDC_BRIDGE_CLIENT_SECRET=
OIDC_BRIDGE_INTERNAL_URL=http://backend:8000
KEYCLOAK_ADMIN_CLIENT_ID=ekb-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=

RATE_LIMIT_ENABLED=true
VIRUS_SCAN_BACKEND=none
METRICS_TOKEN=

BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
LOG_LEVEL=INFO
