{
  "realm": "ekb",
  "displayName": "企业知识库",
  "enabled": true,
  "loginTheme": "ekb",
  "internationalizationEnabled": true,
  "supportedLocales": ["zh-CN", "en"],
  "defaultLocale": "zh-CN",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      { "name": "kb_admin", "description": "知识库平台管理员" },
      { "name": "kb_editor", "description": "知识库编辑者" },
      { "name": "kb_viewer", "description": "知识库只读用户" },
      { "name": "platform_admin", "description": "平台管理员（跨组织）" }
    ]
  },
  "groups": [
    { "name": "engineering", "path": "/engineering", "attributes": { "org_id": ["org-demo"] } },
    { "name": "sales", "path": "/sales", "attributes": { "org_id": ["org-demo"] } }
  ],
  "clients": [
    {
      "clientId": "ekb-frontend",
      "name": "EKB Frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:5173",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000",
        "http://127.0.0.1:5173",
        "http://127.0.0.1:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:3000/*##http://127.0.0.1:5173/*##http://127.0.0.1:3000/*"
      },
      "protocolMappers": [
        {
          "name": "audience-ekb-backend",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ekb-backend",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ekb-backend",
      "name": "EKB Backend API",
      "enabled": true,
      "publicClient": false,
      "secret": "ekb-backend-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "identityProviders": [
    {
      "alias": "wecom",
      "displayName": "企业微信",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "authorizationUrl": "${EKB_PUBLIC_BASE_URL:http://localhost:3000}/oidc/wecom/authorize",
        "issuer": "${EKB_PUBLIC_BASE_URL:http://localhost:3000}/oidc/wecom",
        "tokenUrl": "${EKB_BRIDGE_INTERNAL_URL:http://backend:8000}/oidc/wecom/token",
        "userInfoUrl": "${EKB_BRIDGE_INTERNAL_URL:http://backend:8000}/oidc/wecom/userinfo",
        "jwksUrl": "${EKB_BRIDGE_INTERNAL_URL:http://backend:8000}/oidc/wecom/jwks",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "clientId": "keycloak",
        "clientSecret": "${OIDC_BRIDGE_CLIENT_SECRET:change-me-oidc-bridge-secret}",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid profile email",
        "disableUserInfo": "true",
        "pkceEnabled": "false",
        "syncMode": "FORCE",
        "guiOrder": "1"
      }
    },
    {
      "alias": "dingtalk",
      "displayName": "钉钉",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "authorizationUrl": "${EKB_PUBLIC_BASE_URL:http://localhost:3000}/oidc/dingtalk/authorize",
        "issuer": "${EKB_PUBLIC_BASE_URL:http://localhost:3000}/oidc/dingtalk",
        "tokenUrl": "${EKB_BRIDGE_INTERNAL_URL:http://backend:8000}/oidc/dingtalk/token",
        "userInfoUrl": "${EKB_BRIDGE_INTERNAL_URL:http://backend:8000}/oidc/dingtalk/userinfo",
        "jwksUrl": "${EKB_BRIDGE_INTERNAL_URL:http://backend:8000}/oidc/dingtalk/jwks",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "clientId": "keycloak",
        "clientSecret": "${OIDC_BRIDGE_CLIENT_SECRET:change-me-oidc-bridge-secret}",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid profile email",
        "disableUserInfo": "true",
        "pkceEnabled": "false",
        "syncMode": "FORCE",
        "guiOrder": "2"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "org_id",
      "identityProviderAlias": "wecom",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": { "syncMode": "FORCE", "claim": "org_id", "user.attribute": "org_id" }
    },
    {
      "name": "display-name",
      "identityProviderAlias": "wecom",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": { "syncMode": "FORCE", "claim": "name", "user.attribute": "firstName" }
    },
    {
      "name": "org_id",
      "identityProviderAlias": "dingtalk",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": { "syncMode": "FORCE", "claim": "org_id", "user.attribute": "org_id" }
    },
    {
      "name": "display-name",
      "identityProviderAlias": "dingtalk",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": { "syncMode": "FORCE", "claim": "name", "user.attribute": "firstName" }
    }
  ],
  "users": [
    {
      "username": "service-account-ekb-backend",
      "enabled": true,
      "serviceAccountClientId": "ekb-backend",
      "clientRoles": { "realm-management": ["manage-users", "view-users"] }
    },
    {
      "username": "alice",
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "org_id": ["org-demo"] },
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["default-roles-ekb", "kb_admin", "platform_admin"],
      "groups": ["/engineering"]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Editor",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "org_id": ["org-demo"] },
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["default-roles-ekb", "kb_editor"],
      "groups": ["/engineering"]
    },
    {
      "username": "carol",
      "email": "carol@example.com",
      "firstName": "Carol",
      "lastName": "Viewer",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "org_id": ["org-demo"] },
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["default-roles-ekb", "kb_viewer"],
      "groups": ["/sales"]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"org_id\",\"displayName\":\"Organization ID\",\"validations\":{\"length\":{\"max\":64}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
