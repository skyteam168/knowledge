# Production settings for docker-compose.prod.yml. Copy to .env.prod and fill in every value.
# Generate secrets with: openssl rand -hex 24  (hex: passwords are embedded in connection URLs)

# Image registry / tag pushed by CI (images are built locally when unset).
REGISTRY=ekb
TAG=latest

# Public URLs (behind the TLS-terminating reverse proxy).
PUBLIC_URL=https://kb.example.com
KEYCLOAK_PUBLIC_URL=https://sso.example.com
MINIO_PUBLIC_ENDPOINT=https://files.example.com
# Interfaces the published ports bind to (keep 127.0.0.1 when the proxy runs on the same host).
HTTP_BIND=127.0.0.1
HTTP_PORT=8088
KEYCLOAK_BIND=127.0.0.1
MINIO_BIND=127.0.0.1
OBS_BIND=127.0.0.1

# PostgreSQL (Keycloak uses the `keycloak` database on the same server).
POSTGRES_USER=ekb
POSTGRES_PASSWORD=
POSTGRES_DB=ekb
POSTGRES_MAX_CONNECTIONS=300
POSTGRES_SHARED_BUFFERS=1GB
# (DATABASE_POOL_SIZE + DATABASE_MAX_OVERFLOW) x (WEB_CONCURRENCY + WORKER_PROCESSES + 2)
# must stay below POSTGRES_MAX_CONNECTIONS minus Keycloak's pool (~20).
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

REDIS_PASSWORD=
REDIS_MAXMEMORY=1gb
MINIO_ROOT_USER=ekb
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=ekb-documents
QDRANT_API_KEY=
OPENSEARCH_VERSION=2.19.2
OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=ekb
# Hardened realm (no demo users, TLS required, brute-force protection, password policy).
KEYCLOAK_REALM_FILE=./keycloak/realm-ekb.prod.json

# Processes.
WEB_CONCURRENCY=4
WORKER_PROCESSES=2
WORKER_THREADS=4

# Models (OpenAI-compatible: vLLM / TEI / Xinference ...).
# Alibaba Cloud Model Studio (DashScope) example below; for self-hosted vLLM / TEI use
# RERANK_PATH=/rerank, EMBEDDING_BATCH_SIZE=32, CHAT_EXTRA_BODY={}.
EMBEDDING_BASE_URL=https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_SEND_DIMENSIONS=true
# text-embedding-v4 / v3 accept at most 10 inputs per request (qwen3.7-text-embedding: 20).
EMBEDDING_BATCH_SIZE=10
RERANK_BASE_URL=https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-api/v1
RERANK_MODEL=qwen3-rerank
RERANK_PATH=/reranks
RERANK_INSTRUCT=
CHAT_BASE_URL=https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=deepseek-v4-flash
CHAT_FALLBACK_BASE_URL=
CHAT_FALLBACK_MODEL=
CHAT_EXTRA_BODY={"enable_thinking": false}
CHAT_EVIDENCE_MIN_SCORE=0.45
CHAT_EVIDENCE_CONFIDENT_SCORE=0.7

# Open platform: HMAC pepper for API key hashes (changing it invalidates all issued keys).
OPEN_API_KEY_PEPPER=
# JSON list of reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted for IP allowlists.
OPEN_API_TRUSTED_PROXIES=[]
LLM_API_KEY=
PDF_PARSER=auto
MINERU_API_URL=
INSTALL_DOCLING=false

# Organization directory sync (WeCom / DingTalk / Weaver e-cology / Excel).
# Encrypts stored source credentials; changing it makes saved sources unreadable.
DIRECTORY_SECRET_KEY=
# Abort an apply that would disable more than this share of active users (force to override).
DIRECTORY_SYNC_MAX_DISABLE_RATIO=0.2
# WeCom / DingTalk scan login through the built-in OIDC bridge (PUBLIC_URL is its base URL).
OIDC_BRIDGE_ENABLED=true
# RSA private key (PEM, one line with literal \n). Generate:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | awk 'NF {printf "%s\\n", $0}'
OIDC_BRIDGE_SIGNING_KEY=
# Shared by Keycloak (identity provider client secret) and the backend.
OIDC_BRIDGE_CLIENT_SECRET=
OIDC_BRIDGE_INTERNAL_URL=http://backend:8000
# Keycloak confidential client with realm-management manage-users / view-users
# ("开通密码登录"); the secret is written into the realm on first import.
KEYCLOAK_ADMIN_CLIENT_ID=ekb-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Security.
RATE_LIMIT_ENABLED=true
# clamav: also start the scanner with --profile clamav.
VIRUS_SCAN_BACKEND=none
PII_MASK_ON_INGEST=false
PII_MASK_ON_OUTPUT=false

# Observability. METRICS_TOKEN must equal the content of observability/metrics-token.
METRICS_TOKEN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SAMPLE_RATIO=0.2
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=15d

BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
LOG_LEVEL=INFO
