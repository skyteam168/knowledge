POSTGRES_USER=ekb
POSTGRES_PASSWORD=ekb
POSTGRES_DB=ekb
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Browser-facing Keycloak URL (token issuer). Use http://127.0.0.1:8080 if "localhost" resolves to ::1 and is hijacked.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Browser-facing MinIO URL used for presigned upload / preview links.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# PDF backend: auto | docling | mineru | basic (MinerU needs MINERU_API_URL).
PDF_PARSER=auto
MINERU_API_URL=
# Build backend/worker images with Docling (large download, CPU models).
INSTALL_DOCLING=false
OPENSEARCH_VERSION=2.19.2
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# Model services (OpenAI-compatible). Defaults point to the bundled mock-llm.
EMBEDDING_BASE_URL=http://mock-llm:9100/v1
EMBEDDING_MODEL=mock-embedding
RERANK_BASE_URL=http://mock-llm:9100/v1
RERANK_MODEL=mock-reranker
CHAT_BASE_URL=http://mock-llm:9100/v1
CHAT_MODEL=mock-chat
LLM_API_KEY=EMPTY
MOCK_EMBEDDING_DIM=1024

# Organization directory sync + WeCom / DingTalk scan login (dev defaults are fine locally).
DIRECTORY_SECRET_KEY=change-me-directory-secret
# Browser-facing URL of this platform; WeCom / DingTalk redirect back to <PUBLIC_BASE_URL>/oidc/...
PUBLIC_BASE_URL=http://localhost:3000
OIDC_BRIDGE_CLIENT_SECRET=change-me-oidc-bridge-secret
# Empty in dev: a signing key is generated and shared through Redis.
OIDC_BRIDGE_SIGNING_KEY=
KEYCLOAK_ADMIN_CLIENT_SECRET=ekb-backend-secret
